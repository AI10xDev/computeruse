+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn agent_actions_are_validated_before_execution() {
+        assert!(validate_actions(&[Action::MouseMove { dx: 32_768, dy: 0 }]).is_err());
+        assert!(
+            validate_actions(&[Action::Wait {
+                milliseconds: 30_001,
+            }])
+            .is_err()
+        );
+        assert!(
+            validate_actions(&[Action::KeyTap {
+                key: "code:65535".into(),
+            }])
+            .is_err()
+        );
+        assert!(
+            validate_actions(&[
+                Action::MouseMove { dx: -32_767, dy: 1 },
+                Action::Scroll {
+                    delta: 100,
+                    horizontal: false,
+                },
+                Action::Hotkey {
+                    keys: "ctrl+a".into(),
+                },
+            ])
+            .is_ok()
+        );
+    }
+}
