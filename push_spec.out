     }
+
+    #[test]
+    fn converts_linux_keyboard_events_and_repeats() {
+        let event = InputEvent::new(evdev::EventType::KEY.0, KeyCode::KEY_A.0, 2);
+        assert!(matches!(
+            convert_keyboard_event(event),
+            Some(KeyboardEvent {
+                key: Key { scan_code: 30, .. },
+                state: KeyState::Down,
+                repeat: true,
+                ..
+            })
+        ));
+    }
 }
